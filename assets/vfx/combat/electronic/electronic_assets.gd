	"shaderFacts": {
		"evidence": "Original DX11 ubershader.sm_hi v15 metadata and DXBC disassembly (DIFFUSE_MAP_COUNT=TWO, default REGULAR, MASK_TRANSFORM=OFF).",
		"flare": "GradientMap(vec2(length((UV0 - 0.5) * 2))) * DiffuseColor * Brightness, with scene fog attenuation.",
		"fresnel": "f = pow(1 - saturate(dot(view_direction, normal) - FresnelFactors.z), FresnelFactors.x); gain = FresnelFactors.y >= 0 ? f * FresnelFactors.y : (1 - min(f,1)) * -FresnelFactors.y",
		"normal": "The original vertex shader normalizes the world-3x3-transformed source normal (not an inverse-transpose). Its pixel shader dots interpolated view/normal without fragment renormalization.",
		"output": "RGB *= gain; alpha does not multiply by gain. RGB is independent of input alpha. Scene fog attenuates final RGBA. Do not clamp negative FresnelFactors.y to zero.",
		"rgba": "rgba = DiffuseMap1(uv_1) * DiffuseMap2(uv_2) * MaskMap(UV0) * DiffuseColor",
		"textureColorSpace": "All DiffuseMap/Mask/Gradient shader resources have srgb=false in the original effect metadata.",
		"texturecolor": {
			"branches": "Native metadata also retains Depth and Picking techniques and DEPTH_MAP_OCCLUSION_YES permutation; these do not contribute to the luminous default Main adaptation.",
			"evidence": "Original DX11 texturecolor.sm_hi v15, DEPTH_MAP_OCCLUSION_NO default Main pass pixel shader disassembly.",
			"output": "RGBA = DiffuseMap(uv) * DiffuseColor * Brightness. No Fresnel, radial GradientMap or scene fog sample in default Main.",
			"uv": "UV0 * TextureScaling.xy + TextureTranslation.xy"
		},
		"ubershadertwosided": {
			"evidence": "Original DX11 ubershadertwosided.sm_hi v15 Main has two passes with opposite cull states 22=2 and 22=3. Both original vertex/pixel shader pairs were disassembled.",
			"fresnel": "Same signed Fresnel gain expression, evaluated per vertex using the native normal transform and normalized view direction, then interpolated.",
			"output": "RGBA = DiffuseMap1(uv1) * DiffuseMap2(uv2) * MaskMap(UV0) * DiffuseColor * interpolated_gain. Gain affects alpha too, unlike regular ubershader. No scene fog sample in this original shader.",
			"uv": "Same two transformed/scrolled UV expressions as ubershader, evaluated in the vertex shader then interpolated."
		},
		"uv": "uv_i = UV0 * TextureTransform_i.zw + TextureTransform_i.xy + TextureScroll_i.xy * time + TextureScroll_i.zw"
	},
